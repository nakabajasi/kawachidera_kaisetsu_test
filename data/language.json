  "certainty_phrases": {
    "_about": "確からしさ（certainty）ごとの代表的な語尾。実際の語尾は下の modality_endings を使い、ここは modality が無いデータのための予備。",
    "confirmed": ["ことが確認されています。"],
    "probable": ["と考えられています。"],
    "possible": ["可能性があります。"],
    "uncertain": ["とも考えられていますが、はっきりとは分かっていません。"]
  },

