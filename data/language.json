      "definition": { "intro": [""], "outro": [""] },
      "period": { "intro": ["", "いつごろのことか、見てみましょう。"], "outro": [""] },
      "location": { "intro": [""], "outro": [""] },
      "size": { "intro": ["", "大きさを見てみましょう。"], "outro": [""] },
