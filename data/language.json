  "polite_rewrites": {
    "_about": "断定の文（polite）の文末だけを話し方に合わせて言い換える規則。意味と確からしさは変えない。上から順に最初に合ったものを使う。",
    "normal": [],
    "guide": [],
    "friendly": [
      { "match": "いません。", "to": ["いません。", "いないんです。"] },
      { "match": "ありません。", "to": ["ありません。", "ないんです。"] },
      { "match": "ませんでした。", "to": ["ませんでした。"] },
      { "match": "ています。", "to": ["ています。", "ているんです。", "ていますよ。"] },
      { "match": "ました。", "to": ["ました。", "ましたよ。"] },
      { "match": "です。", "to": ["です。", "なんです。", "ですよ。"] },
      { "match": "ます。", "to": ["ます。", "ますよ。"] }
    ]
  },

